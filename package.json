{
  "name": "pdfx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PDFX — a local-first PDF editor desktop app",
  "scripts": {
    "dev": "vite",
    "prototype": "vite --open /prototype.html",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "setup:native": "bash scripts/setup-native.sh",
    "build:macos": "bash scripts/build-macos.sh",
    "build:macos:arm64": "bash scripts/build-macos-arm64.sh",
    "verify:macos": "bash scripts/verify-macos-bundle.sh",
    "verify:macos:arm64": "PDFX_EXPECTED_ARCH=arm64 bash scripts/verify-macos-bundle.sh",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
