{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF document",
        "description": "PDF document",
        "mimeType": "application/pdf",
        "role": "Editor",
        "rank": "Default"
      }
    ],
    "macOS": {
      "frameworks": ["vendor/pdfium/lib/libpdfium.dylib"],
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": false,
      "signingIdentity": "-"
    },
    "resources": {
      "../docs/install-macos.md": "INSTALL-macos.md",
      "vendor/pdfium/LICENSE": "pdfium-licenses/LICENSE",
      "vendor/pdfium/licenses/": "pdfium-licenses/",
      "fonts/SOURCE.txt": "font-licenses/SOURCE.txt",
      "fonts/NotoSansSC-OFL.txt": "font-licenses/NotoSansSC-OFL.txt",
      "fonts/NotoSerifSC-OFL.txt": "font-licenses/NotoSerifSC-OFL.txt",
      "fonts/ZhuqueFangsong-OFL.txt": "font-licenses/ZhuqueFangsong-OFL.txt",
      "fonts/LXGWWenKai-OFL.txt": "font-licenses/LXGWWenKai-OFL.txt",
      "fonts/SmileySans-OFL.txt": "font-licenses/SmileySans-OFL.txt",
      "fonts/MaShanZheng-OFL.txt": "font-licenses/MaShanZheng-OFL.txt",
      "fonts/ZCOOLXiaoWei-OFL.txt": "font-licenses/ZCOOLXiaoWei-OFL.txt",
      "fonts/ZCOOLQingKeHuangYou-OFL.txt": "font-licenses/ZCOOLQingKeHuangYou-OFL.txt"
    }
  }
}
