  "identifier": "default",
  "description": "Default capability for the PDFX workspace and document windows",
  "windows": ["main", "document-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "dialog:default"
  ]
